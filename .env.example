# ClickUp Authentication (Choose ONE method)

# Method 1: Direct Access Token (Recommended - Simplest)
CLICKUP_ACCESS_TOKEN=your_access_token_here

# Method 2: OAuth Credentials (Advanced - for automatic token refresh)
# CLICKUP_CLIENT_ID=your_client_id_here
# CLICKUP_CLIENT_SECRET=your_client_secret_here

# Optional: GitHub Repository
GITHUB_REPO=your-org/your-repo
